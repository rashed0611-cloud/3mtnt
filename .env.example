# ------------------------------------------------------------------
# Supabase (production / staging)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Local development mode
# Used only when the Supabase values above are absent. The app then
# runs against a file-backed store in .data/db.json with a single
# super-administrator account.
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=3M Tours & Travels ERP
# Public site origin used by sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production-please-use-a-long-random-value
LOCAL_ADMIN_EMAIL=superadmin@3mtnt.com
LOCAL_ADMIN_PASSWORD=Welcome@3M2026
LOCAL_ADMIN_NAME=Super Administrator
