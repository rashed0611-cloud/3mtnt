# ------------------------------------------------------------------
# Supabase (production / staging)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Local demo mode
# When Supabase values are absent the app uses a file-backed demo
# database in .data/db.json so everything works without a backend.
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=3M Tours & Travels ERP
# Public site origin used by sitemap.xml and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production-please-use-a-long-random-value
DEMO_ADMIN_EMAIL=admin@3mtours.com
DEMO_ADMIN_PASSWORD=demo1234
DEMO_ADMIN_NAME=Demo Administrator

# Optional: seed a larger fictional dataset on first run
DEMO_SEED_SCALE=full
